# The other half of the Workload Identity pair.
#
# deploy/k8s/base declares this service account and says nothing about who it is
# outside the cluster, which is right: on a laptop it is nobody, and on this
# cloud it is the account holding objectAdmin on one bucket. The annotation is
# what makes the node's application default credentials resolve to that account,
# and it is why nothing in this deployment holds an object store key.
#
# Generated by deploy/terraform/gcp. Edit the template, not this file.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: quire
  annotations:
    iam.gke.io/gcp-service-account: ${service_account}
