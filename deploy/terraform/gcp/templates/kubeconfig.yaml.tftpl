# Generated by deploy/terraform/gcp. It holds no credential: the token is minted
# by the gke-gcloud-auth-plugin each time kubectl runs.
apiVersion: v1
kind: Config
clusters:
  - name: quire
    cluster:
      server: https://${endpoint}
      certificate-authority-data: ${authority}
contexts:
  - name: quire
    context:
      cluster: quire
      user: quire
current-context: quire
users:
  - name: quire
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1beta1
        command: gke-gcloud-auth-plugin
        provideClusterInfo: true
        interactiveMode: Never
