# Generated by deploy/terraform/aws. It holds no credential: the token is minted
# by the AWS CLI each time kubectl runs.
apiVersion: v1
kind: Config
clusters:
  - name: quire
    cluster:
      server: ${endpoint}
      certificate-authority-data: ${authority}
contexts:
  - name: quire
    context:
      cluster: quire
      user: quire
current-context: quire
users:
  - name: quire
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1beta1
        command: aws
        args:
          - --region
          - ${region}
          - eks
          - get-token
          - --cluster-name
          - ${cluster}
          - --output
          - json
        interactiveMode: Never
