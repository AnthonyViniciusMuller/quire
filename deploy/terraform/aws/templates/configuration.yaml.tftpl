# The three values that make this deployment ${domain} and not a node.
#
# Generated by deploy/terraform/aws. Edit the template, not this file.
apiVersion: v1
kind: ConfigMap
metadata:
  name: quire-node
data:
  QUIRE_SERVER_NAME: ${domain}
  # The origin of the discovery documents, which is the gateway and not the
  # node: a peer fetches them over HTTPS from the domain, and the domain
  # resolves to the load balancer in front of the gateway that answers for it.
  QUIRE_SERVER_BASE_URL: https://${domain}
  # And the authority peers dial for gRPC, which is neither the port the node
  # listens on nor the port the documents are served from. 9443 is passed
  # through untouched by both the load balancer and the gateway, because the
  # federation connection is pinned at both ends and anything that terminated
  # it would break both — C23 in docs/tcc-corrections.md.
  QUIRE_GRPC_ADVERTISED_ADDRESS: ${domain}:9443
  # The bucket, patched here rather than carried in quire-storage beside the key
  # pair. The base's ConfigMap and its four Secrets deliberately name no
  # variable twice — a bucket in both would make the deployment depend on the
  # order envFrom happens to resolve them in.
  QUIRE_STORAGE_BUCKET: ${bucket}
