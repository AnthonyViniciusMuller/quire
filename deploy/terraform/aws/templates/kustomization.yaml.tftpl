# The generated layer, and the only Kubernetes deploy/terraform/aws writes.
#
# Everything about how a Quire node is deployed is in deploy/k8s. What is here
# is the three things that directory deliberately does not know: which domain
# this node answers for, which images it runs, and how this cloud publishes a
# gateway. Each one is a fact about an apply and not about the system.
#
# Generated by deploy/terraform/aws. Edit the template, not this file.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: quire

resources:
  - ../../../k8s/overlays/cloud

# One tag for both. They move together because the schema is versioned with the
# binary that expects it: a deployment of one commit applies the migrations of
# that commit.
images:
  - name: ghcr.io/anthonyvsmuller/quired
    newName: ${split(":", node_image)[0]}
    newTag: ${split(":", node_image)[1]}
  - name: ghcr.io/anthonyvsmuller/quire-migrate
    newName: ${split(":", migrate_image)[0]}
    newTag: ${split(":", migrate_image)[1]}

patches:
  # The three values that make this deployment ${domain}.
  - path: configuration.yaml

  # And how it is reached from outside the cluster.
  - path: gateway-service.yaml

  # The domain, written into every resource that asserts one. These are JSON
  # patches and not merges because each target is an element of a list: a merge
  # appends a second host beside the placeholder rather than replacing it, and a
  # gateway that also answers for quire.example is a gateway answering for a
  # domain nobody owns.
  - target:
      kind: Certificate
      name: quire-federation-tls
    patch: |-
      - op: replace
        path: /spec/dnsNames/0
        value: ${domain}
  - target:
      kind: Certificate
      name: quire-gateway-tls
    patch: |-
      - op: replace
        path: /spec/dnsNames/0
        value: ${domain}

  # Only the SNI, and only on the federation route. The discovery route matches
  # any authority, because a gateway belongs to one node and an authority
  # carries a port; SNI is a name, carries none, and is what a caller verifies
  # the certificate against.
  - target:
      kind: VirtualService
      name: quire-federation
    patch: |-
      - op: replace
        path: /spec/tls/0/match/0/sniHosts/0
        value: ${domain}

  # The browser lane originates a connection to the node's own API port and
  # verifies the certificate it finds there, which asserts this one name.
  - target:
      kind: DestinationRule
      name: quire-api
    patch: |-
      - op: replace
        path: /spec/trafficPolicy/tls/sni
        value: ${domain}
      - op: replace
        path: /spec/trafficPolicy/tls/subjectAltNames/0
        value: ${domain}
